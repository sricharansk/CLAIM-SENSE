# Copy to .env and adjust. Never commit a real .env file.

# Database: SQLite by default; PostgreSQL in docker-compose.
# DATABASE_URL=postgresql+psycopg://claimsense:claimsense-local@localhost:5432/claimsense
DATABASE_URL=sqlite:///./claimsense.db
POSTGRES_PASSWORD=claimsense-local

# Seed synthetic policies and the 8 golden claims on startup (idempotent).
CLAIMSENSE_SEED=true
CLAIMSENSE_STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_BYTES=10485760
RAG_MIN_SCORE=0.15

# Sign-in. AUTH_SECRET signs login tokens: set a long random value in every shared deployment.
AUTH_SECRET=
TOKEN_TTL_HOURS=12
# Password for the synthetic demo accounts: adjuster, supervisor, auditor.
DEMO_PASSWORD=claimsense-demo

# Optional: an Anthropic API key turns on LLM-written answers in the policy assistant.
# Without it, answers are extractive quotes of the policy wording. Amounts never come from the LLM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
